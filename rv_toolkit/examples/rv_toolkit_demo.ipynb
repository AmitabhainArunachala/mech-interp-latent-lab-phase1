    "---\n",
    "\n",
    "## Part 3: Activation Patching (Conceptual)\n",
    "\n",
    "Activation patching is the causal validation method used in the paper. Here's how it works conceptually:\n",
    "\n",
    "1. **Baseline run**: Process baseline prompt → capture V activations at target layer\n",
    "2. **Recursive run**: Process recursive prompt → capture V activations\n",
    "3. **Patched run**: Process baseline prompt but patch in V from recursive run\n",
    "4. **Measure**: Compute how much the patched run resembles recursive processing\n",
    "\n",
    "The `rv_toolkit` provides the `ActivationPatcher` class for this. Below is a conceptual demonstration."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Conceptual activation patching demonstration\n",
    "\n",
    "from dataclasses import dataclass\n",
    "\n",
    "@dataclass\n",
    "class PatchingResult:\n",
    "    \"\"\"Simulated patching result for demonstration\"\"\"\n",
    "    baseline_rv: float\n",
    "    recursive_rv: float\n",
    "    patched_rv: float\n",
    "    transfer_efficiency: float\n",
    "    delta_rv: float\n",
    "    \n",
    "\n",
    "def simulate_activation_patching(n_samples=50):\n",
    "    \"\"\"\n",
    "    Simulate activation patching results.\n",
    "    In real use, this would use actual transformer activations.\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    \n",
    "    for i in range(n_samples):\n",
    "        # Baseline: high R_V\n",
    "        b_act, _ = create_baseline_activation()\n",
    "        baseline_rv = compute_rv(torch.from_numpy(b_act).float(), window_size=16).rv\n",
    "        \n",
    "        # Recursive: low R_V\n",
    "        r_act, _ = create_recursive_activation()\n",
    "        recursive_rv = compute_rv(torch.from_numpy(r_act).float(), window_size=16).rv\n",
    "        \n",
    "        # Patched: somewhere in between (80-95% transfer)\n",
    "        transfer = np.random.uniform(0.8, 0.95)\n",
    "        patched_rv = baseline_rv + transfer * (recursive_rv - baseline_rv)\n",
    "        \n",
    "        delta_rv = patched_rv - baseline_rv\n",
    "        transfer_eff = compute_transfer_efficiency(baseline_rv, recursive_rv, patched_rv)\n",
    "        \n",
    "        results.append(PatchingResult(\n",
    "            baseline_rv=baseline_rv,\n",
    "            recursive_rv=recursive_rv,\n",
    "            patched_rv=patched_rv,\n",
    "            transfer_efficiency=transfer_eff,\n",
    "            delta_rv=delta_rv\n",
    "        ))\n",
    "    \n",
    "    return results\n",
    "\n",
    "\n",
    "# Run simulation\n",
    "patching_results = simulate_activation_patching(n_samples=50)\n",
    "\n",
    "# Extract arrays\n",
    "baseline_vals = np.array([r.baseline_rv for r in patching_results])\n",
    "recursive_vals = np.array([r.recursive_rv for r in patching_results])\n",
    "patched_vals = np.array([r.patched_rv for r in patching_results])\n",
    "transfer_vals = np.array([r.transfer_efficiency for r in patching_results])\n",
    "\n",
    "print(f\"Simulated {len(patching_results)} patching experiments\")\n",
    "print(f\"\\nMean transfer efficiency: {transfer_vals.mean():.1%}\")\n",
    "print(f\"Transfer range: {transfer_vals.min():.1%} - {transfer_vals.max():.1%}\")"
   ]
  },
