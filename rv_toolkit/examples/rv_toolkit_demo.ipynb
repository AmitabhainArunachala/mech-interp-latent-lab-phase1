    "print(f\"  Baseline: {baseline_vals.mean():.4f}\")\n",
    "print(f\"  Patched:  {patched_vals.mean():.4f} (Δ = {patched_vals.mean() - baseline_vals.mean():.4f})\")\n",
    "print(f\"  Recursive: {recursive_vals.mean():.4f}\")"
