    "---\n",
    "\n",
    "## Part 4: Dual-Space Decomposition\n",
    "\n",
    "The paper's novel finding: in-subspace ($V_{\\parallel}$) and orthogonal ($V_{\\perp}$) components contract **coordinately** (r = 0.904), revealing unified geometric mechanism."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demonstrate dual-space decomposition\n",
    "\n",
    "def simulate_dual_space_analysis(n_samples=100):\n",
    "    \"\"\"\n",
    "    Simulate dual-space decomposition results.\n",
    "    Shows that V_parallel and V_perpendicular contract coordinately.\n",
    "    \"\"\"\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    # Baseline: both components have high participation ratios\n",
    "    baseline_parallel = np.random.normal(0.85, 0.05, n_samples)\n",
    "    baseline_perp = np.random.normal(0.80, 0.06, n_samples)\n",
    "    \n",
    "    # Recursive: both components contract together (coordinated)\n",
    "    # Strong correlation between parallel and perp contraction\n",
    "    contraction_factor = np.random.normal(0.65, 0.08, n_samples)\n",
    "    recursive_parallel = baseline_parallel * contraction_factor + np.random.normal(0, 0.02, n_samples)\n",
    "    recursive_perp = baseline_perp * contraction_factor + np.random.normal(0, 0.02, n_samples)\n",
    "    \n",
    "    # Patched: partial transfer of both components\n",
    "    transfer = 0.85\n",
    "    patched_parallel = baseline_parallel + transfer * (recursive_parallel - baseline_parallel)\n",
    "    patched_perp = baseline_perp + transfer * (recursive_perp - baseline_perp)\n",
    "    \n",
    "    return {\n",
    "        'baseline_parallel': baseline_parallel,\n",
    "        'baseline_perp': baseline_perp,\n",
    "        'recursive_parallel': recursive_parallel,\n",
    "        'recursive_perp': recursive_perp,\n",
    "        'patched_parallel': patched_parallel,\n",
    "        'patched_perp': patched_perp\n",
    "    }\n",
