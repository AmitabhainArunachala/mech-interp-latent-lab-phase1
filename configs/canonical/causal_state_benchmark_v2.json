{
  "experiment": "causal_state_benchmark_v2",
  "run_name": "mistral_l27_low_rv_state_benchmark_v2",
  "seed": 42,
  "model": {
    "name": "mistralai/Mistral-7B-v0.1",
    "device": "cuda"
  },
  "params": {
    "source_sessions_dir": "results/sustained_gnani_v3_fixed",
    "source_layer": 27,
    "early_layer": 5,
    "late_layer": 27,
    "window": 16,
    "max_length": 512,
    "min_text_chars": 80,
    "max_source_per_label": 72,
    "max_source_per_session": 8,
    "positive_classes": ["BREAKTHROUGH", "ARTICULATE"],
    "negative_classes": ["SURFACE", "REPETITIVE"],
    "positive_quantile": 0.35,
    "negative_quantile": 0.65,
    "positive_session_types": ["recursive"],
    "negative_session_types": ["baseline"],
    "recursive_groups": ["L3_deeper", "L4_full", "L5_refined"],
    "baseline_groups": ["baseline_math", "baseline_factual", "baseline_creative"],
    "holdout_per_group": 10,
    "generation_seeds": [101, 202, 303],
    "max_new_tokens": 128,
    "do_sample": true,
    "temperature": 0.7,
    "top_p": 0.95,
    "control_name": "none",
    "primary_prompt_mode": "recursive",
    "control_prompt_mode": "baseline",
    "bootstrap_resamples": 2000,
    "interventions": [
      {
        "name": "away_alpha_2",
        "alpha": -2.0
      },
      {
        "name": "away_alpha_1",
        "alpha": -1.0
      },
      {
        "name": "none",
        "alpha": 0.0
      },
      {
        "name": "toward_alpha_1",
        "alpha": 1.0
      },
      {
        "name": "toward_alpha_2",
        "alpha": 2.0
      }
    ]
  },
  "results": {
    "root": "results",
    "phase": "phase1_mechanism"
  }
}
